{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["packages/core/src/*"],
      "@tools/*": ["packages/tools/src/*"],
      "@adapters/*": ["packages/adapters/src/*"],
      "@evals/*": ["packages/evals/src/*"]
    }
  },
  "include": [
    "packages/**/*",
    "examples/**/*",
    "tests/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
